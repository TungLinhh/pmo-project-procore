{
  "name": "pmo-mvp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "PMO (Project Management Office) MVP — construction project tracking, KPI, shop drawings, material submittals, payments",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "setup": "node scripts/setup-demo.mjs",
    "setup:postgres": "bash backend/scripts/db-bootstrap.sh",
    "demo:seed": "node scripts/load-demo-seed.mjs",
    "demo:export": "node scripts/export-demo-seed.mjs",
    "demo:dates": "node scripts/rebase-demo-dates.mjs",
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "test": "node tests/e2e/api.mjs && node tests/e2e/payment-sla.mjs && node tests/e2e/shop-approval.mjs && node tests/e2e/schema.mjs",
    "test:api": "node tests/e2e/api.mjs",
    "test:payment": "node tests/e2e/payment-sla.mjs",
    "test:shop": "node tests/e2e/shop-approval.mjs",
    "test:schema": "node tests/e2e/schema.mjs",
    "test:browser": "node tests/e2e/browser.mjs",
    "test:all": "npm test && npm run test:browser && node tests/tools/schema-audit.mjs",
    "test:srs": "node scripts/run-srs-gate.mjs",
    "test:ai": "node tests/e2e/ai-srs-evaluation.mjs",
    "test:ai-progress": "node tests/e2e/ai-progress-proposals.mjs",
    "test:ai-progress-concurrency": "node tests/e2e/ai-progress-concurrency.mjs",
    "test:sp-ap": "node tests/e2e/sp-ap-unknown-payment.mjs",
    "test:release": "node scripts/release-gate.mjs",
    "test:monitoring": "node tests/e2e/monitoring.mjs",
    "test:retention": "node tests/e2e/retention.mjs",
    "test:security": "node tests/e2e/refresh-reuse.mjs && node tests/e2e/realtime.mjs && node tests/e2e/secrets-hygiene.mjs",
    "test:reconcile": "node tests/e2e/reconcile-values.mjs",
    "storage:gc": "node scripts/storage-gc.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "audit:schema": "node tests/tools/schema-audit.mjs",
    "sp-ap:sample": "node scripts/build-sp-ap-sample.mjs",
    "test:step1": "node scripts/build-sp-ap-sample.mjs && SP_FILE=data/samples/sp-ap-from-demo.xlsx node tests/e2e/step1-05-sp-ap.mjs && SP_FILE=data/samples/sp-ap-from-demo.xlsx node tests/e2e/step1-06-bte-dashboard.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.0.1",
    "xlsx": "npm:@e965/xlsx@^0.20.3"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
