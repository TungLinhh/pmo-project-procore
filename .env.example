# PMO production env (Coolify / compose). Copy to .env and fill secrets.
# The backend builds its connection string itself: set EITHER DATABASE_URL
# OR the DB_* parts (DATABASE_URL wins when both are set).

# Option A — single URL (Coolify managed Postgres):
# DATABASE_URL=postgresql://pmo_user:CHANGE_ME@postgres:5432/pmo

# Option B — parts:
DB_HOST=postgres
DB_PORT=5432
DB_NAME=pmo
DB_USER=pmo_user
DB_PASSWORD=CHANGE_ME

PORT=3000
NODE_ENV=production
# Set 1 when exactly one reverse proxy (Cloudflare/Coolify) sits in front.
TRUST_PROXY=1
# Refuse to start when a required production secret/hatch is missing.
PRODUCTION_ENFORCE_READINESS=1
# Comma-separated origin allowlist. Unset in production = same-origin only
# (single-port deployment serves the SPA itself, so no CORS is needed).
# Unset in dev keeps the permissive default the Vite proxy expects.
# CORS_ORIGIN=https://pmo.example.vn

# REQUIRED in production (dev default otherwise — see server log warning):
JWT_SECRET=CHANGE_ME_32_CHARS_MIN
# First boot only. init.js refuses to create a production admin without a
# password of at least 12 characters. Remove it after the first successful run.
# ADMIN_INITIAL_PASSWORD=CHANGE_ME_12_CHARS_MIN
# ACCESS_TTL_SEC=86400

# Daily "Cần xử lý" digest (in-app always; email when SMTP is configured).
# DIGEST_HOUR=7
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=pmo@example.com

# Backup connection may use a dedicated PostgreSQL role with BYPASSRLS.
# FORCE RLS applies even to table owners, so the normal owner URL cannot pg_dump.
# BACKUP_DB_PASSWORD=CHANGE_ME
# BACKUP_DATABASE_URL=postgresql://pmo_backup:CHANGE_ME@postgres:5432/pmo

# Upload volume path inside the container. This MUST be a mount point of its own
# (the compose `uploads` volume is mounted here): uploads sharing a filesystem
# with the app tree live in the container's writable layer and are lost whenever
# the image is replaced. production-readiness check `uploads_volume` fails if
# the directory does not exist or is on the same device as its parent.
UPLOADS_DIR=/app/backend/uploads
# PG_POOL_MAX=10

# ---- Retention of operational logs (lib/retention.js) ------------------------
# Only expired sessions, revoked-jti and AI telemetry are swept. Business data
# and notifications are never touched. Every value has a 1-day floor, because a
# window of 0 would match rows written a millisecond ago.
# SESSION_RETENTION_DAYS=30      # expired refresh tokens + revoked jti
# AI_LOG_RETENTION_DAYS=90       # ai_calls telemetry
# AUDIT_RETENTION_DAYS=0         # 0 = keep the audit trail forever (default)
# RETENTION_MIN_ROWS=10000       # never prune a table smaller than this
# Plan (read-only):  GET  /api/jobs/retention
# Run it:             POST /api/jobs/retention/run      (admin/CEO)

# ---- Realtime stream ticket (routes/stream.js) ------------------------------
# EventSource cannot set an Authorization header, so /api/stream takes a
# short-lived single-use ticket instead of the access token. This is the window
# a client has to open one stream; a new ticket is minted on every reconnect.
# STREAM_TICKET_TTL_SEC=45

# ---- Refresh token reuse detection (lib/auth.js) ----------------------------
# A refresh token presented after it was already rotated means the chain may be
# stolen: the whole family is revoked and every live access token dies. Within
# this window it is treated as two tabs refreshing at once instead.
# REFRESH_REUSE_GRACE_MS=10000

# Request-traffic DB role (Wave 2 A1, least privilege; default pmo_app).
# Rollback to owner = APP_DB_USER=pmo_user. init.js sets the role password
# from APP_DB_PASSWORD each boot (dev default pmo_app_dev_pwd).
# APP_DB_USER=pmo_app
# APP_DB_PASSWORD=CHANGE_ME

# S3-compatible storage (Wave D1; default driver is local disk).
# Point at the compose minio service or any S3 API (R2/Viettel/AWS).
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=pmo-uploads
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME
# Local development can keep files on the uploads volume. Production compose
# requires the S3 settings above and never stores documents in the image.
# STORAGE_DRIVER=local

# AI layer (v0.7.0): provider API keys. Keys live ONLY here — the DB stores the
# env var NAME per tenant (ai_provider_configs), never the secret. Unset key +
# tenant routed to that provider → 503 naming the exact var. Mock mode for tests:
# AI_MOCK=1 (no network, deterministic fake vectors/text, zero spend).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OpenRouter gateway (real model, e.g. nvidia/nemotron-3-ultra-550b-a55b:free):
# OPENROUTER_API_KEY=
# Optional same-key chat fallback; leave unset to use only tenant DB routes.
# The demo migration also adds `stealth/space-bunny-alpha` at priority 1 for OpenRouter tenants.
# AI_CHAT_FALLBACK_MODEL=stealth/space-bunny-alpha
# AI_CHAT_FALLBACK_PROVIDER=openrouter
# AI_CHAT_FALLBACK_API_KEY_ENV=OPENROUTER_API_KEY
# AI_PROVIDER_TIMEOUT_MS=15000
# Reasoning models (nemotron/space-bunny) need a much longer budget: measured
# Nemotron writes 600-3000 chars of thinking on a retrieved-context prompt.
# AI_REASONING_TIMEOUT_MS=120000
# Whole-request budget, stops trying candidates once spent.
# AI_TOTAL_BUDGET_MS=300000
# AI_RETRY_DELAY_MS=1500

# Control Layer apply authority (SRS Table 9: PM/PMO apply "trong thẩm quyền").
# Thẩm quyền = ngưỡng tác động đo được, không phải tên role.
# PILLAR_APPLY_AUTHORITY=on
# PILLAR_APPLY_MAX_SHIFT_DAYS=14
# PILLAR_APPLY_MAX_COST_VND=500000000
# PILLAR_APPLY_MAX_AFFECTED_ITEMS=20
# Đặt PILLAR_APPLY_AUTHORITY=off để tạm quay về CEO/Admin-only (không cần deploy).
# AI_MONTHLY_CAP_USD=20

# Trust layer task 10 (SRS NFR Bao mat + SRS 6 SSO): song ngu/mã hoá/PDPL/SSO.
# Column encryption (AES-256-GCM): base64 32 bytes HOẶC 64 hex. Không đặt =
# plaintext + warn (chỉ dev). Production BẮT BUỘC đặt (xem security-status).
# DATA_ENC_KEY=
# SSO OIDC IdP ngoài (1 secret/tenant qua tên biến trong sso_configs.secret_env):
# SSO_CLIENT_SECRET=
# PUBLIC_BASE_URL=https://pmo.congty.vn
# Test-only hatch (giữ mặc định tắt ở production): cho phép nạp client_secret
# qua API vào memory (mất khi restart).
# ALLOW_SSO_INLINE_SECRET=0
